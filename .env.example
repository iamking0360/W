# Database Configuration:
# For Global / Cloud Production (Supabase, Neon, Render, Railway, Vercel Postgres, AWS RDS):
# Paste your PostgreSQL connection string below:
DATABASE_URL=postgresql://username:password@hostname:5432/database_name?sslmode=require
# Or local SQLite fallback path if DATABASE_URL is not set:
DATABASE_PATH=database.db

MAX_CONTENT_LENGTH=52428800

